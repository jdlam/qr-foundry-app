# Optional local overrides for `vite dev` / `npm run dev:web`.
# Copy to .env.local (gitignored) to enable. None of these are required.

# PostHog project API key (public client key — starts with phc_).
# US cloud region. Only loaded by the web build (@platform alias).
# Identified-mode config is enforced in src/platform/web/analytics.ts.
# VITE_POSTHOG_KEY=

# Optional: override PostHog ingest host. Defaults to https://us.i.posthog.com.
# VITE_POSTHOG_HOST=https://us.i.posthog.com
